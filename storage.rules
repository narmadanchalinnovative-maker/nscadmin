rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow public reads for all files (adjust if needed)
    match /{allPaths=**} {
      allow read: if true;
      // By default deny writes unless specifically allowed below
      allow write: if false;
    }

    // Allow uploads for live classes assets (thumbnails, recordings) from admin UI.
    // NOTE: This rule is intentionally permissive to unblock development. Restrict
    // it before production (require authentication or signed upload tokens).
    match /live_classes/{docId}/{fileName} {
      allow read: if true;
      allow write: if (
        // limit size to 100MB and allow common media types
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*') ||
        request.resource.contentType.matches('video/.*') ||
        request.resource.contentType.matches('application/.*')
      );
    }

    match /uploads/{rest=**} {
      allow read: if true;
      allow write: if (
        request.resource.size < 100 * 1024 * 1024 &&
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('application/pdf'))
      );
    }

    match /notifications/{fileName} {
      allow read: if true;
      allow write: if (
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }

    match /banners/{fileName} {
      allow read: if true;
      allow write: if (
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }

    match /branding/{fileName} {
      allow read: if true;
      allow write: if (
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*')
      );
    }

    match /courses/{courseId}/subjects/{subjectId}/chapters/{chapterId}/lectures/{rest=**} {
      allow read: if true;
      allow write: if (
        request.resource.size < 1024 * 1024 * 1024 && // 1GB limit for videos
        (request.resource.contentType.matches('image/.*') ||
         request.resource.contentType.matches('video/.*') ||
         request.resource.contentType.matches('application/.*'))
      );
    }

    // Fallback: deny writes to other paths
    match /{rest=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}