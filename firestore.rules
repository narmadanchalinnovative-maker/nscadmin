rules_version = '2';
// Firestore Security Rules - Admin Panel + Custom Auth (Twilio)
// Copy this to Firebase Console > Firestore > Rules tab
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS FOR VALIDATION
    // =========================================================================
    
    function hasValidAdminMetadata() {
      return request.resource.data.keys().hasAll(['createdBy', 'updatedBy']) &&
        request.resource.data.createdBy is string &&
        request.resource.data.updatedBy is string &&
        request.resource.data.createdBy.size() > 0 &&
        request.resource.data.updatedBy.size() > 0;
    }

    function isValidEntity() {
      return request.resource.data.keys().hasAny(['title', 'description', 'status']) &&
        request.resource.data.title is string &&
        request.resource.data.description is string &&
        request.resource.data.status in ['active', 'inactive'] &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 255 &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.description.size() <= 2000 &&
        (!('price' in request.resource.data) || (request.resource.data.price is number && request.resource.data.price >= 0));
    }

    function isValidSection() {
      return request.resource.data.keys().hasAll(['title', 'status', 'testId']) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 255 &&
        request.resource.data.status in ['active', 'inactive'] &&
        request.resource.data.testId is string &&
        request.resource.data.testId.size() > 0 &&
        (!request.resource.data.keys().hasAny(['description']) || 
          (request.resource.data.description is string && 
           request.resource.data.description.size() <= 2000)) &&
        (!request.resource.data.keys().hasAny(['order']) || 
          request.resource.data.order is number);
    }

    function isValidQuestion() {
      return request.resource.data.keys().hasAll(['text', 'status', 'testId', 'options']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 5000 &&
        request.resource.data.status in ['active', 'inactive'] &&
        request.resource.data.testId is string &&
        request.resource.data.testId.size() > 0 &&
        request.resource.data.options is list &&
        request.resource.data.options.size() >= 2 &&
        request.resource.data.options.size() <= 20 &&
        (!request.resource.data.keys().hasAny(['marks']) || 
          (request.resource.data.marks is number && 
           request.resource.data.marks >= 0)) &&
        (!request.resource.data.keys().hasAny(['negativeMarks']) || 
          (request.resource.data.negativeMarks is number && 
           request.resource.data.negativeMarks >= 0)) &&
        (!request.resource.data.keys().hasAny(['correctOptionIndex']) || 
          (request.resource.data.correctOptionIndex is number && 
           request.resource.data.correctOptionIndex >= 0 &&
           request.resource.data.correctOptionIndex < request.resource.data.options.size())) &&
        (!request.resource.data.keys().hasAny(['correctOptionIndexes']) || 
          (request.resource.data.correctOptionIndexes is list && 
           request.resource.data.correctOptionIndexes.size() > 0)) &&
        (!request.resource.data.keys().hasAny(['solution']) || 
          (request.resource.data.solution is string && 
           request.resource.data.solution.size() <= 5000));
    }



    function hasValidEmbeddedQuestions() {
      return !request.resource.data.keys().hasAny(['questions']) || 
        (request.resource.data.questions is list && 
         request.resource.data.questions.size() <= 1000);
    }

    function hasLiveAccessData() {
      return (
        request.resource.data.keys().hasAny(['streamUrl']) &&
        request.resource.data.streamUrl is string &&
        request.resource.data.streamUrl.size() > 0
      ) || (
        request.resource.data.keys().hasAny(['zoomMeetingId']) &&
        request.resource.data.zoomMeetingId is string &&
        request.resource.data.zoomMeetingId.size() > 0
      ) || (
        request.resource.data.keys().hasAny(['meetingId']) &&
        request.resource.data.meetingId is string &&
        request.resource.data.meetingId.size() > 0
      );
    }

    function isValidLiveClass() {
      return request.resource.data.keys().hasAll([
        'title',
        'subject',
        'status'
      ]) &&

      request.resource.data.title is string &&
      request.resource.data.title.size() > 0 &&
      request.resource.data.title.size() <= 255 &&

      request.resource.data.subject is string &&
      request.resource.data.subject.size() > 0 &&
      request.resource.data.subject.size() <= 255 &&

      request.resource.data.status in [
        'live',
        'upcoming',
        'completed',
        'ended',
        'recorded'
      ] &&

      hasLiveAccessData() &&

      (!request.resource.data.keys().hasAny(['streamUrl']) ||
        (request.resource.data.streamUrl is string &&
         request.resource.data.streamUrl.size() <= 2000)) &&

      (!request.resource.data.keys().hasAny(['zoomMeetingId']) ||
        (request.resource.data.zoomMeetingId is string &&
         request.resource.data.zoomMeetingId.size() <= 128)) &&

      (!request.resource.data.keys().hasAny(['meetingId']) ||
        (request.resource.data.meetingId is string &&
         request.resource.data.meetingId.size() <= 128)) &&

      (!request.resource.data.keys().hasAny(['zoomPassword']) ||
        (request.resource.data.zoomPassword is string &&
         request.resource.data.zoomPassword.size() <= 128)) &&

      (!request.resource.data.keys().hasAny(['meetingPassword']) ||
        (request.resource.data.meetingPassword is string &&
         request.resource.data.meetingPassword.size() <= 128)) &&

      (!request.resource.data.keys().hasAny(['zoomDisplayName']) ||
        (request.resource.data.zoomDisplayName is string &&
         request.resource.data.zoomDisplayName.size() <= 255)) &&

      (!request.resource.data.keys().hasAny(['meetingDisplayName']) ||
        (request.resource.data.meetingDisplayName is string &&
         request.resource.data.meetingDisplayName.size() <= 255)) &&

      (!request.resource.data.keys().hasAny(['thumbnailUrl']) ||
        (request.resource.data.thumbnailUrl is string &&
         request.resource.data.thumbnailUrl.size() > 0)) &&

      (!request.resource.data.keys().hasAny(['description']) ||
        (request.resource.data.description is string &&
         request.resource.data.description.size() <= 5000)) &&

      (!request.resource.data.keys().hasAny(['teacherName']) ||
        (request.resource.data.teacherName is string &&
         request.resource.data.teacherName.size() <= 255)) &&

      (!request.resource.data.keys().hasAny(['teacherRole']) ||
        (request.resource.data.teacherRole is string &&
         request.resource.data.teacherRole.size() <= 255)) &&

      (!request.resource.data.keys().hasAny(['roomTitle']) ||
        (request.resource.data.roomTitle is string &&
         request.resource.data.roomTitle.size() <= 255)) &&

      (!request.resource.data.keys().hasAny(['roomSubtitle']) ||
        (request.resource.data.roomSubtitle is string &&
         request.resource.data.roomSubtitle.size() <= 255)) &&

      (!request.resource.data.keys().hasAny(['order']) ||
        request.resource.data.order is number) &&

      (!request.resource.data.keys().hasAny(['createdAt']) ||
        request.resource.data.createdAt is timestamp) &&

      (!request.resource.data.keys().hasAny(['updatedAt']) ||
        request.resource.data.updatedAt is timestamp);
    }

    function hasTimestamps() {
      return request.resource.data.keys().hasAll(['createdAt', 'updatedAt']) &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp;
    }

    // =========================================================================
    // GLOBAL CONFIGURATIONS (READ-ONLY FOR APP CLIENTS)
    // =========================================================================
    
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if hasValidAdminMetadata();
    }

    match /app_pages/{document=**} {
      allow read: if true;
      allow create, update: if hasValidAdminMetadata() && hasTimestamps();
      allow delete: if true;
    }

    // =========================================================================
    // NOTIFICATIONS
    // =========================================================================
    match /notifications/{document=**} {
      allow read: if true;
      allow write: if false; // Only admin SDKs / Cloud Functions can write
    }

    // =========================================================================
    // DOUBTS
    // =========================================================================
    match /doubts/{document=**} {
      allow read: if true;
      allow write: if true; // Allow users to create doubts and admin to manage
    }

    // =========================================================================
    // SUPPORT TICKETS
    // =========================================================================
    match /support_tickets/{document=**} {
      allow read: if true;
      allow write: if true; // Allow users to create tickets and admin to manage
    }

    // =========================================================================
    // MIGRATION TOKENS (EXTERNAL SERVICE AUTH)
    // =========================================================================
    match /migration_tokens/{tokenId} {
      allow read: if true;
      allow update: if (request.resource.data.used == true && 
        request.resource.data.keys().hasAll(['used']));
      allow create, delete: if false;
    }

    // =========================================================================
    // USERS COLLECTION (CUSTOM AUTH - TWILIO)
    // =========================================================================
    match /users/{uid} {
      allow read: if true;
      
      allow create, update: if 
        request.resource.data.keys().hasAny(['uid', 'phoneNumber']) &&
        request.resource.data.uid is string &&
        request.resource.data.uid.size() > 0 &&
        (!request.resource.data.keys().hasAny(['name']) || 
          (request.resource.data.name is string && 
           request.resource.data.name.size() <= 255)) &&
        (!request.resource.data.keys().hasAny(['email']) || 
          (request.resource.data.email is string && 
           request.resource.data.email.size() <= 255));
        
      allow delete: if true;

      match /{subPath=**} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // ADMIN USERS COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /admin_users/{uid} {
      allow read: if true;
      
      allow create, update: if 
        request.resource.data.keys().hasAny(['email', 'role', 'active', 'permissions']) &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        request.resource.data.email.size() <= 255 &&
        request.resource.data.role in ['super_admin', 'admin', 'editor'] &&
        request.resource.data.active is bool &&
        request.resource.data.permissions is list &&
        request.resource.data.permissions.size() <= 100 &&
        (!request.resource.data.keys().hasAny(['name']) || 
          (request.resource.data.name is string && 
           request.resource.data.name.size() <= 255));
        
      allow delete: if true;
    }

    // =========================================================================
    // BANNERS COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /banners/{docId} {
      allow read: if true;
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
      allow delete: if true;
    }

    // =========================================================================
    // EVENTS COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /events/{docId} {
      allow read: if true;
      
      allow create, update: if 
        isValidEntity() && 
        hasValidAdminMetadata() &&
        hasTimestamps() &&
        (!request.resource.data.keys().hasAny(['thumbnail']) || 
          (request.resource.data.thumbnail is string && 
           request.resource.data.thumbnail.size() > 0));
        
      allow delete: if true;
    }

    // =========================================================================
    // BATCHES COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /batches/{docId} {
      allow read: if true;
      
      allow create, update: if (
        (isValidEntity() || true) && // skip strict validation if admin metadata exists
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
        
      allow delete: if true;

      match /courses/{courseId} {
        allow read: if true;

        allow create, update: if (
          hasValidAdminMetadata() &&
          hasTimestamps() &&
          request.resource.data.keys().hasAny(['batchId']) &&
          request.resource.data.batchId is string &&
          request.resource.data.batchId == docId
        );

        allow delete: if true;
      }

      match /tests/{testId} {
        allow read: if true;

        allow create, update: if (
          hasValidAdminMetadata() &&
          hasTimestamps() &&
          request.resource.data.keys().hasAny(['batchId']) &&
          request.resource.data.batchId is string &&
          request.resource.data.batchId == docId
        );

        allow delete: if true;

        match /questions/{questionId} {
          allow read: if true;

          allow create, update: if (
            hasValidAdminMetadata() &&
            hasTimestamps()
          );

          allow delete: if true;
        }
      }
    }

    // =========================================================================
    // COURSES COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /courses/{docId} {
      allow read: if true;
      
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
        
      allow delete: if true;
    }

    // =========================================================================
    // SUBJECTS COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /subjects/{docId} {
      allow read: if true;
      
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
        
      allow delete: if true;
    }

    // =========================================================================
    // CHAPTERS COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /chapters/{docId} {
      allow read: if true;
      
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
        
      allow delete: if true;
    }

    // =========================================================================
    // LECTURES COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /lectures/{docId} {
      allow read: if true;
      
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
        
      allow delete: if true;
    }

    // =========================================================================
    // TESTS COLLECTION (ADMIN PANEL)
    // =========================================================================
    match /tests/{docId} {
      allow read: if true;
      
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
        
      allow delete: if true;

      match /questions/{questionId} {
        allow read: if true;

        allow create, update: if (
          isValidQuestion() &&
          hasValidAdminMetadata() &&
          hasTimestamps()
        );

        allow delete: if true;
      }
    }

    // =========================================================================
    // SECTIONS COLLECTION (TEST CONTENT)
    // =========================================================================
    match /sections/{docId} {
      allow read: if true;

      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );

      allow delete: if true;
    }

    // =========================================================================
    // QUESTIONS COLLECTION (TEST CONTENT)
    // =========================================================================
    match /questions/{docId} {
      allow read: if true;

      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );

      allow delete: if true;
    }

    // =========================================================================
    // LIVE CLASSES COLLECTION (LIVE CLASS SCREENS)
    // =========================================================================
    match /live_classes/{docId} {
      allow read: if true;

      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );

      allow delete: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // =========================================================================
    // STUDENT RESPONSES COLLECTION (STUDENT ATTEMPT DATA)
    // =========================================================================
    match /student_responses/{responseId} {
      allow read: if true;

      allow create, update: if (
        request.resource.data.keys().hasAll(['studentId', 'testId', 'questionId', 'selectedOptionIndex', 'timestamp']) &&
        request.resource.data.studentId is string &&
        request.resource.data.studentId.size() > 0 &&
        request.resource.data.testId is string &&
        request.resource.data.testId.size() > 0 &&
        request.resource.data.questionId is string &&
        request.resource.data.questionId.size() > 0 &&
        request.resource.data.selectedOptionIndex is number &&
        request.resource.data.timestamp is timestamp
      );

      allow delete: if true;
    }

    // =========================================================================
    // LECTURE COMMENTS COLLECTION (STUDENT LECTURE COMMENTS)
    // =========================================================================
    match /lecture_comments/{commentId} {
      allow read: if true;
      allow create: if (
        request.resource.data.keys().hasAll(['lectureId', 'userId', 'userName', 'text', 'createdAt']) &&
        request.resource.data.lectureId is string &&
        request.resource.data.lectureId.size() > 0 &&
        request.resource.data.userId is string &&
        request.resource.data.userId.size() > 0 &&
        request.resource.data.userName is string &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        request.resource.data.createdAt is timestamp
      );
      // Let users update/delete their own comments (basic authorization)
      allow update, delete: if true; // In production, add rule: request.auth.uid == resource.data.userId
    }

    // =========================================================================
    // AUDIT LOGS (OPTIONAL - ADMIN ACTION TRACKING)
    // =========================================================================
    match /audit_logs/{logId} {
      allow read: if true;
      
      allow create: if (
        request.resource.data.keys().hasAll(['action', 'admin', 'timestamp', 'collection']) &&
        request.resource.data.action is string &&
        request.resource.data.admin is string &&
        request.resource.data.collection is string &&
        request.resource.data.action.size() > 0 &&
        request.resource.data.admin.size() > 0 &&
        request.resource.data.collection.size() > 0 &&
        request.resource.data.timestamp is timestamp &&
        (!request.resource.data.keys().hasAny(['details']) || 
          request.resource.data.details is map)
      );
        
      allow update, delete: if false;
    }

    // =========================================================================
    // EXAM GOALS & LOGS
    // =========================================================================
    match /exam_goals/{docId} {
      allow read: if true;
      allow create, update: if (
        hasValidAdminMetadata() &&
        hasTimestamps()
      );
      allow delete: if true;
    }

    match /goal_change_logs/{docId} {
      allow read: if true;
      allow create: if true; // Allow users to create logs
      allow update, delete: if true;
    }

    // =========================================================================
    // BATCHES & BATCH NOTES
    // =========================================================================
    match /batches/{batchId} {
      allow read: if true;
      allow write: if true;
      
      match /notes/{noteId} {
        allow read: if true;
        allow write: if true;
      }
    }

    // =========================================================================
    // TEST ATTEMPTS
    // =========================================================================
    match /test_attempts/{attemptId} {
      allow read: if true;
      allow write: if true;
    }

    // =========================================================================
    // FALLBACK RULE (DENY EVERYTHING ELSE BY DEFAULT)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}